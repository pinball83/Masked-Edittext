<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/sampleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_label"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.github.pinball83.maskededittext.MaskedEditText
            android:id="@+id/phoneField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone_hint"
            android:inputType="phone"
            app:mask="8 (***) *** **-**"
            app:notMaskedSymbol="*" />

        <TextView
            android:id="@+id/phoneState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:text="@string/state_placeholder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/card_label"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.github.pinball83.maskededittext.MaskedEditText
            android:id="@+id/cardField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_hint"
            android:inputType="number"
            app:mask="**** **** **** ****"
            app:notMaskedSymbol="*" />

        <TextView
            android:id="@+id/cardState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:text="@string/state_placeholder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dynamic_label"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <FrameLayout
            android:id="@+id/dynamicHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
